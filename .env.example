# Application
# Production/Vercel: use Postgres URL from Vercel Storage / Neon
# Local: use the same Postgres URL, or a local Postgres instance
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Company contact (required before launch)
SUPPORT_EMAIL="support@spectbillltd.store"

# Stripe (required for live subscriptions)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_YEARLY=""
STRIPE_PRICE_PROFESSIONAL_MONTHLY=""
STRIPE_PRICE_PROFESSIONAL_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_YEARLY=""

# Email / SMTP (optional — contact form stores messages without it)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
